# Local server
PORT=3000

# Any secret string you invent. Meta sends it back when you register the webhook.
VERIFY_TOKEN=replace-with-a-long-random-string

# From the WhatsApp > API Setup screen in your Meta app.
# Temporary tokens expire in about 24 hours. Use a system user token for daily use.
WHATSAPP_TOKEN=
PHONE_NUMBER_ID=

# Your personal WhatsApp number, country code included, digits only.
# Example: 15551234567
OWNER_PHONE=

# From App settings > Basic. Used to confirm webhooks really came from Meta.
APP_SECRET=

# Approved utility template for reminders sent when you have not messaged the bot in 24 hours.
# Body example: Reminder: {{1}}
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANG=en_US

# Graph API version. Override if Meta's API Setup page shows a newer one.
GRAPH_API_VERSION=v25.0
